{
	"apiVersion": 3,
	"name": "potiskarium-theme/dropdown-menu-block",
	"title": "Potiskarium Dropdown Menu",
	"category": "potiskarium-theme-blocks",
	"icon": "list-view",
	"editorScript": "file:./editor.js",
	"viewScript": "file:../collapsible-categories-block/collapsible-menu.js",
	"render": "file:./index.php",
	"attributes": {
